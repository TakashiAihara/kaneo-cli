{
  "name": "kaneo-cli",
  "private": true,
  "description": "Command-line interface for Kaneo, the open source project management tool",
  "keywords": [
    "cli",
    "kanban",
    "kaneo",
    "project-management",
    "tasks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TakashiAihara/kaneo-cli.git"
  },
  "type": "module",
  "scripts": {
    "generate": "orval --config orval.config.ts && bun scripts/request-shapes.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "bun scripts/build.ts",
    "parity:record": "bun scripts/record-golden.ts",
    "spec": "bun scripts/spec.ts",
    "rebase:main": "bun scripts/rebase-main.ts"
  },
  "dependencies": {
    "jq-wasm": "3.0.0-jq-1.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "fast-check": "4.11.0",
    "knip": "6.39.0",
    "orval": "8.39.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^5.9.0"
  }
}
