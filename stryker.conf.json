{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/html/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "concurrency": 8,
  "timeoutMS": 600000,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "mutate": []
}
